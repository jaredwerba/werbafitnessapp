{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix frontend && npm ci --prefix api",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    { "source": "/train/api/(.+)", "destination": "/api?p=$1" },
    { "source": "/api/(.+)", "destination": "/api?p=$1" },
    { "source": "/train", "destination": "/index.html" },
    { "source": "/train/(.*)", "destination": "/$1" },
    { "source": "/((?!api(?:/|$)|assets/).*)", "destination": "/index.html" }
  ]
}
